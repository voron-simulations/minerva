{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"label": "cargo build"
		},
		{
			"type": "shell",
			"command": "hemtt",
			"args": [
				"build",
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "HEMTT build",
			"dependsOn": "cargo build",
		}
	]
}